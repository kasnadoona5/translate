# Tarjomeh v9.1 environment template
# Copy to .env, replace placeholders, and keep .env private.

# ---------------------------------------------------------------------------
# Translator
# ---------------------------------------------------------------------------
# Empty API_BASE means direct OpenRouter.
# For 9router, use the Docker-host gateway, for example:
# http://172.17.0.1:20128/v1
TRANSLATOR_API_BASE=
TRANSLATOR_API_KEY=replace-with-real-key
TRANSLATOR_MODEL=deepseek/deepseek-v4-flash
TRANSLATOR_MAX_TOKENS=12000

# Optional translator fallback used only during bounded recovery.
TRANSLATOR_RECOVERY_MODEL=
TRANSLATOR_RECOVERY_MAX_ATTEMPTS=2
TRANSLATOR_RECOVERY_MAX_TOKENS=24000

# ---------------------------------------------------------------------------
# Independent critic / judge
# ---------------------------------------------------------------------------
# Blank endpoint/key inherit the translator values.
CRITIC_ENABLED=false
CRITIC_API_BASE=
CRITIC_API_KEY=
CRITIC_MODEL=

# Critic attempt 1 remains unchanged. These settings apply to recovery only.
CRITIC_RECOVERY_MODEL=
CRITIC_RECOVERY_MAX_ATTEMPTS=4
CRITIC_RECOVERY_MAX_TOKENS=24000

# ---------------------------------------------------------------------------
# Web research
# ---------------------------------------------------------------------------
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CX=

# ---------------------------------------------------------------------------
# Web UI
# ---------------------------------------------------------------------------
UI_SECRET_TOKEN=replace-with-a-long-random-value
FLASK_SECRET_KEY=replace-with-another-long-random-value

# ---------------------------------------------------------------------------
# Legacy compatibility
# ---------------------------------------------------------------------------
# Legacy translator names still work when referenced by config.toml:
# OPENROUTER_API_KEY=
# OPENROUTER_API_BASE=

# Multiple-key rotation:
# 1. Define named keys here, for example:
# OPENROUTER_TRANSLATOR_KEY_1=
# OPENROUTER_TRANSLATOR_KEY_2=
# OPENROUTER_CRITIC_KEY_1=
# OPENROUTER_CRITIC_KEY_2=
# 2. Reference them from config.toml [llm.openrouter].api_keys and
#    [llm.critic].api_keys.
# 3. Leave TRANSLATOR_API_KEY / CRITIC_API_KEY empty so they do not replace
#    the TOML lists with a single key.
