# =============================================================================
# Tarjomeh — Secrets & Environment  (copy to .env and fill in)
# =============================================================================
# This file holds SECRETS ONLY. Behavior (models, judge, modes, output format)
# is configured in config.toml — see config.example.toml, Scenarios A/B/C.

# --- Main API key (the TRANSLATOR uses this) --------------------------------
# Scenario A (OpenRouter direct): your real key from openrouter.ai (sk-or-...)
# Scenario B/C (via 9router):     the key your 9router instance accepts
OPENROUTER_API_KEY=your-key-here

# For key ROTATION add more keys as separate variables, then list them in
# config.toml:  api_keys = ["${OPENROUTER_API_KEY}", "${OPENROUTER_API_KEY_2}"]
# OPENROUTER_API_KEY_2=second-key-here

# --- Endpoint for the translator (OPTIONAL) ---------------------------------
# Where LLM requests go when config.toml [llm.openrouter] api_base = "".
#   Not set                            → https://openrouter.ai/api/v1 (direct)
#   http://172.17.0.1:20128/v1         → 9router running on the same VPS
# OPENROUTER_API_BASE=http://172.17.0.1:20128/v1

# --- Judge/critic key (OPTIONAL — Scenario C) --------------------------------
# Only needed when the judge uses a DIFFERENT account/endpoint than the
# translator (e.g. translator via 9router, judge via OpenRouter directly).
# Reference it in config.toml:  [llm.critic] api_keys = ["${CRITIC_API_KEY}"]
# CRITIC_API_KEY=sk-or-your-real-openrouter-key

# --- Local models (OPTIONAL) --------------------------------------------------
OLLAMA_HOST=http://localhost:11434

# --- Web UI -------------------------------------------------------------------
# REQUIRED for web access: open http://your-server:8080?token=THIS_VALUE
UI_SECRET_TOKEN=your-secret-token

# Flask session key (auto-generated if not set)
# FLASK_SECRET_KEY=random-secret-key
