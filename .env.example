# =========================================================================
# Tarjomeh — fill this ONE file and you are done. (copy to .env)
# You never need to edit config.toml.
# =========================================================================

# ---- TRANSLATOR (main model) — you can use openrouter or 9router ----
# API_BASE: leave EMPTY for OpenRouter.
#           For 9router on this VPS use:  http://172.17.0.1:20128/v1
TRANSLATOR_API_BASE=
TRANSLATOR_API_KEY=your-key-here
TRANSLATOR_MODEL=deepseek/deepseek-v4-flash

# ---- CRITIC / JUDGE (optional second model that grades the translation) ----
# Use a STRONG model here (not a free congested one).
# It can use a DIFFERENT endpoint/key than the translator.
CRITIC_ENABLED=false
CRITIC_API_BASE=
CRITIC_API_KEY=
CRITIC_MODEL=

# ---- WEB RESEARCH (optional, recommended for Phase 7) ----
# Tarjomeh prefers Tavily, then Brave, then the existing Google/DDG fallbacks.
# Configure either official API key; never put these keys in config.toml.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# ---- WEB UI ----
# Open the site with:  http://YOUR-SERVER-IP:8080/?token=THIS-VALUE
UI_SECRET_TOKEN=my-secret-vps-token

# =========================================================================
# EXAMPLES — copy the block you want over the lines above
# =========================================================================
#
# (A) Everything on OpenRouter (simplest):
#   TRANSLATOR_API_BASE=
#   TRANSLATOR_API_KEY=sk-or-xxxxxxxx
#   TRANSLATOR_MODEL=deepseek/deepseek-v4-flash
#   CRITIC_ENABLED=true
#   CRITIC_API_BASE=
#   CRITIC_API_KEY=sk-or-xxxxxxxx
#   CRITIC_MODEL=anthropic/claude-sonnet-5
#
# (B) Everything through 9router (your combos handle fallback):
#   TRANSLATOR_API_BASE=http://172.17.0.1:20128/v1
#   TRANSLATOR_API_KEY=your-9router-key
#   TRANSLATOR_MODEL=combo1
#   CRITIC_ENABLED=true
#   CRITIC_API_BASE=http://172.17.0.1:20128/v1
#   CRITIC_API_KEY=your-9router-key
#   CRITIC_MODEL=combo2
#
# (C) MIXED — cheap translator via 9router + strong judge via OpenRouter:
#   TRANSLATOR_API_BASE=http://172.17.0.1:20128/v1
#   TRANSLATOR_API_KEY=your-9router-key
#   TRANSLATOR_MODEL=combo1
#   CRITIC_ENABLED=true
#   CRITIC_API_BASE=https://openrouter.ai/api/v1
#   CRITIC_API_KEY=sk-or-xxxxxxxx
#   CRITIC_MODEL=anthropic/claude-sonnet-5
#
# =========================================================================
# Advanced (optional — fine to ignore)
# =========================================================================
# TRANSLATOR_MAX_TOKENS=8192       # output budget per request (default 8192)
# OLLAMA_HOST=http://localhost:11434
# FLASK_SECRET_KEY=random-secret-key
# Legacy names (still work for the translator):
# OPENROUTER_API_KEY=  OPENROUTER_API_BASE=
