# ----- Tarjomeh Environment Variables -----

# LLM API Keys
OPENROUTER_API_KEY=your-key-here
# For key rotation, use comma-separated keys:
# OPENROUTER_API_KEYS=key1,key2,key3

# Ollama (local LLM)
OLLAMA_HOST=http://localhost:11434

# Web UI Authentication (REQUIRED for web access)
UI_SECRET_TOKEN=your-secret-token

# Flask secret key (auto-generated if not set)
# FLASK_SECRET_KEY=random-secret-key
